{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dopedb-workspace-scheduler",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-14",
  "account_id": "0af3820c996f277b2f17ee446d03f60a",
  "workers_dev": true,
  "preview_urls": false,
  "secrets": {
    "required": ["KICK_TOKEN", "WORKSPACE_CRON_SECRET"]
  },
  "vars": {
    "WORKSPACE_ORIGIN": "https://app.dopedb.dev"
  },
  "d1_databases": [
    {
      "binding": "SCHEDULER_DB",
      "database_name": "dopedb-workspace-scheduler",
      "database_id": "34a4d522-cb7c-4587-8510-07655764d87a",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
