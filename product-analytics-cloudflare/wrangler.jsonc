{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dopedb-product-analytics",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-14",
  "account_id": "0af3820c996f277b2f17ee446d03f60a",
  "workers_dev": true,
  "preview_urls": false,
  "secrets": {
    "required": ["INGEST_TOKEN"]
  },
  "d1_databases": [
    {
      "binding": "ANALYTICS_DB",
      "database_name": "dopedb-product-analytics",
      "database_id": "b07a4643-7e4b-4f57-b0ad-14dd99b812ec",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["17 3 * * *"]
  }
}
