{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["query_tokens", "search_intent"],
  "properties": {
    "query_tokens": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 40
      }
    },
    "search_intent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  }
}
