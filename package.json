{
  "name": "dopedb",
  "private": true,
  "version": "0.3.19",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "vite",
    "build": "pnpm check:skills && tsc && vite build",
    "generate:skills": "node scripts/generate-skill-bundle.mjs",
    "check:skills": "node scripts/generate-skill-bundle.mjs --check",
    "check:test-budget": "node scripts/check-critical-test-budget.mjs",
    "test": "node scripts/check-critical-test-budget.mjs && vitest run src/components/DataGridVirtual.test.ts src/features/providers/tauriAdapter.test.ts src/features/queries/tauriAdapter.test.ts src/features/query/runSignal.test.ts src/features/skills/setupPolicy.test.ts src/features/terminals/state.test.ts src/features/workbench/state.test.ts src/features/workspaces/authPolicy.test.ts",
    "test:smoke": "vitest run src/components/DataGridVirtual.test.ts src/features/providers/tauriAdapter.test.ts src/features/queries/tauriAdapter.test.ts src/features/query/runSignal.test.ts src/features/skills/setupPolicy.test.ts src/features/terminals/state.test.ts src/features/workbench/state.test.ts src/features/workspaces/authPolicy.test.ts",
    "test:rust": "cargo test --package dopedb --lib && cargo test --package dopedb-protocol --test golden && cargo test --package dopedb-cli --test terminal_session_e2e",
    "workspace:migrate": "bash scripts/migrate-workspace-service.sh",
    "workspace:cloud:dev": "pnpm --dir workspace-cloud dev",
    "workspace:cloud:build": "pnpm --dir workspace-cloud build",
    "repo:identity": "bash scripts/configure-repository-identity.sh",
    "gh:owner": "bash scripts/with-gh-owner.sh",
    "gh:restore": "bash scripts/with-gh-owner.sh --restore",
    "build:sidecars": "bash scripts/build-sidecars.sh",
    "sign:dev": "bash src-tauri/sign-dev.sh",
    "dev:app": "pnpm tauri dev",
    "preview": "vite preview",
    "site:dev": "pnpm --dir site dev",
    "site:build": "pnpm --dir site build",
    "site:preview": "pnpm --dir site start",
    "site:preview-image": "python3 site/scripts/generate-preview.py",
    "icons": "python3 scripts/generate-icons.py",
    "tauri": "bash scripts/tauri.sh"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@iconify-react/simple-icons": "1.0.22",
    "@tanstack/react-query": "^5.101.4",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@uiw/react-codemirror": "^4.25.11",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "12.11.2",
    "codemirror": "^6.0.2",
    "elkjs": "0.12.0",
    "jspdf": "4.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sql-formatter": "15.8.2"
  },
  "devDependencies": {
    "@babel/parser": "8.0.4",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "happy-dom": "20.11.1",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
