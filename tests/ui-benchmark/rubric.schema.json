{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dopedb.local/ui-benchmark/rubric.schema.json",
  "title": "DopeDB UX benchmark scorecard",
  "description": "비차단 리뷰 산출물이다. 이 schema를 통과해도 baseline을 자동 승인하거나 merge를 차단하지 않는다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scene", "referenceId", "scores", "findings", "reviewer", "blocking"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "scene": {
      "type": "string",
      "description": "tests/ui-harness/scenarios에 등록된 장면 id",
      "minLength": 1
    },
    "referenceId": {
      "type": "string",
      "description": "manifest.json references[].id",
      "minLength": 1
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orientation",
        "workbenchHierarchy",
        "densityAndAlignment",
        "actionLocality",
        "contextContinuity",
        "accessibility"
      ],
      "properties": {
        "orientation": { "$ref": "#/$defs/score" },
        "workbenchHierarchy": { "$ref": "#/$defs/score" },
        "densityAndAlignment": { "$ref": "#/$defs/score" },
        "actionLocality": { "$ref": "#/$defs/score" },
        "contextContinuity": { "$ref": "#/$defs/score" },
        "accessibility": { "$ref": "#/$defs/score" }
      }
    },
    "findings": {
      "type": "array",
      "description": "모든 감점에는 화면 영역과 관찰 근거가 있어야 한다.",
      "items": { "$ref": "#/$defs/finding" }
    },
    "reviewer": {
      "type": "string",
      "enum": ["human", "agent"],
      "description": "개인 이메일이나 GitHub login을 기록하지 않는다. 승인 주체는 git history가 제공한다."
    },
    "blocking": {
      "const": false,
      "description": "AI 평가는 변동성이 있어 CI 필수 조건으로 쓰지 않는다."
    }
  },
  "$defs": {
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region", "severity", "evidence", "recommendation"],
      "properties": {
        "region": {
          "type": "string",
          "enum": ["rail", "explorer", "workbench", "assistant", "status", "dialog"]
        },
        "severity": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "evidence": {
          "type": "string",
          "description": "관찰 가능한 화면 또는 measurements.json의 측정값",
          "minLength": 12
        },
        "recommendation": {
          "type": "string",
          "description": "검증 가능한 변경 하나만 제안한다.",
          "minLength": 12
        }
      }
    }
  }
}
